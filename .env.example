# Copie para .env e preencha. Nunca versione o .env real.

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# False em produção; True só em desenvolvimento local.
DEBUG=True

# Hosts separados por vírgula (produção: inclua o domínio do Render).
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco Neon SEPARADO do Hamilton antigo. Vazio => usa SQLite local (db.sqlite3).
DATABASE_URL=

# Origens confiáveis de CSRF em produção (ex.: https://seu-app.onrender.com).
CSRF_TRUSTED_ORIGINS=

# Token da Webmania (NFS-e) — usado a partir da fase fiscal (D16+).
WEBMANIA_API_TOKEN=

# Banco de PRODUÇÃO do Hamilton ANTIGO — só para a migração de corte único (D6),
# executada no go-live. Ver ../hamilton-api/.env. Deixe vazio fora do go-live.
LEGADO_DATABASE_URL=

# --- WhatsApp (Cloud API da Meta) — mesmas credenciais do projeto Sofia ---
# Bearer token permanente (system user) e id do número na Cloud API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# 'true' (padrão) NÃO envia nada, só loga. Mude para 'false' para enviar.
WHATSAPP_DRY_RUN=true
# Se preenchido, TODAS as mensagens vão para esse número (modo teste).
# Ex. do número de teste: 5531830551118
WHATSAPP_TEST_NUMBER=
